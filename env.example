# IGL — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (painel do Supabase → Project Settings → API).
# NUNCA commite o .env.local. Nunca use a chave service_role no front-end.

# URL do projeto, no formato https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Chave pública "anon" (publishable)
VITE_SUPABASE_ANON_KEY=
