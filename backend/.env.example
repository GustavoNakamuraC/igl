# Copie para backend/.env.local e preencha. O .env.local NÃO vai para o git.
#
# Supabase: painel → Connect (ou Project Settings → Database) → "Session pooler".
# Converta a connection string para JDBC, por exemplo:
#   postgresql://postgres.abcdefgh:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# vira:
#   DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.abcdefgh
#   DB_PASSWORD=[SENHA]
#
# Postgres local (docker compose up -d na raiz do repo): deixe os valores abaixo.
DB_URL=jdbc:postgresql://localhost:5432/igl
DB_USERNAME=igl
DB_PASSWORD=igl
